FROM jupyter/pyspark-notebook:python-3.11@sha256:7d0b19de594978b8c0541194d91e29abba40e20aa124873bcf5e9cda2fe037f7

LABEL maintainer="ELT Lab" \
      description="JupyterLab with PySpark, Java, and Data Science libraries for ELT Lab"

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        gcc \
    && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}

RUN pip install --no-cache-dir \
        numpy==1.26.4 \
        pandas==2.2.3 \
        polars==1.12.0 \
        duckdb==1.1.3 \
        pyarrow==17.0.0 \
        openpyxl==3.1.5 \
        sqlalchemy==2.0.36 \
        psycopg2-binary==2.9.10 \
        requests==2.32.3 \
        matplotlib==3.9.2 \
        seaborn==0.13.2 \
        plotly==5.24.1 \
        scikit-learn==1.5.2 \
        pytest==8.3.3 \
        nbformat==5.10.4

ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PYSPARK_PYTHON=python
ENV PYSPARK_DRIVER_PYTHON=python

RUN mkdir -p /home/jovyan/work/ELT /home/jovyan/work/Data\ Lab/datasets

COPY docker/jupyter_entrypoint.sh /usr/local/bin/jupyter_entrypoint.sh
RUN chmod +x /usr/local/bin/jupyter_entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["tini", "--", "/usr/local/bin/jupyter_entrypoint.sh"]
