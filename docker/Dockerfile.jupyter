FROM jupyter/pyspark-notebook:python-3.11@sha256:7d0b19de594978b8c0541194d91e29abba40e20aa124873bcf5e9cda2fe037f7

LABEL maintainer="ELT Lab" \
      description="JupyterLab with PySpark, Java, and Data Science libraries for ELT Lab"

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        gcc \
    && rm -rf /var/lib/apt/lists/* && \
    curl --fail --location --retry 3 -o "$SPARK_HOME/jars/hadoop-aws-3.3.4.jar" \
        https://repo.maven.apache.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl --fail --location --retry 3 -o "$SPARK_HOME/jars/aws-java-sdk-bundle-1.12.262.jar" \
        https://repo.maven.apache.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    curl --fail --location --retry 3 -o "$SPARK_HOME/jars/postgresql-42.7.4.jar" \
        https://repo.maven.apache.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar && \
    echo "a65839fbf1869f81a1632e09f415e586922e4f80  $SPARK_HOME/jars/hadoop-aws-3.3.4.jar" | sha1sum -c - && \
    echo "02deec3a0ad83d13d032b1812421b23d7a961eea  $SPARK_HOME/jars/aws-java-sdk-bundle-1.12.262.jar" | sha1sum -c - && \
    echo "264310fd7b2cd76738787dc0b9f7ea2e3b11adc1  $SPARK_HOME/jars/postgresql-42.7.4.jar" | sha1sum -c -

USER ${NB_UID}

RUN pip install --no-cache-dir \
        numpy==1.26.4 \
        pandas==2.2.3 \
        polars==1.12.0 \
        duckdb==1.1.3 \
        pyarrow==17.0.0 \
        openpyxl==3.1.5 \
        sqlalchemy==2.0.36 \
        psycopg2-binary==2.9.10 \
        requests==2.32.3 \
        matplotlib==3.9.2 \
        seaborn==0.13.2 \
        plotly==5.24.1 \
        scikit-learn==1.5.2 \
        pyspark==3.5.0 \
        pytest==8.3.3 \
        nbformat==5.10.4

ENV PYSPARK_PYTHON=python \
    PYSPARK_DRIVER_PYTHON=python \
    PYTHONPATH=/opt

RUN mkdir -p /home/jovyan/work/ELT /home/jovyan/work/Data\ Lab/datasets

COPY --chmod=755 --chown=${NB_UID}:${NB_GID} docker/jupyter_entrypoint.sh /usr/local/bin/jupyter_entrypoint.sh
RUN tr -d '\r' < /usr/local/bin/jupyter_entrypoint.sh > /tmp/jupyter_entrypoint.sh && \
    cat /tmp/jupyter_entrypoint.sh > /usr/local/bin/jupyter_entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["tini", "--", "/usr/local/bin/jupyter_entrypoint.sh"]
