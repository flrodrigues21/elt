FROM apache/airflow:2.9.3-python3.11@sha256:cc5fcb91e93e4dfe4fd8b1b53a9155dfa2670fb829891a9658a0f36ac55f67ef

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    openjdk-17-jre-headless \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

USER airflow

COPY docker/requirements-airflow.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt" && \
    pip install --no-cache-dir pyspark==3.5.0 && \
    SPARK_JARS="$(python -c 'import pathlib, pyspark; print(pathlib.Path(pyspark.__file__).parent / "jars")')" && \
    curl --fail --location --retry 3 -o "$SPARK_JARS/hadoop-aws-3.3.4.jar" \
        https://repo.maven.apache.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl --fail --location --retry 3 -o "$SPARK_JARS/aws-java-sdk-bundle-1.12.262.jar" \
        https://repo.maven.apache.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    curl --fail --location --retry 3 -o "$SPARK_JARS/postgresql-42.7.4.jar" \
        https://repo.maven.apache.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar && \
    echo "a65839fbf1869f81a1632e09f415e586922e4f80  $SPARK_JARS/hadoop-aws-3.3.4.jar" | sha1sum -c - && \
    echo "02deec3a0ad83d13d032b1812421b23d7a961eea  $SPARK_JARS/aws-java-sdk-bundle-1.12.262.jar" | sha1sum -c - && \
    echo "264310fd7b2cd76738787dc0b9f7ea2e3b11adc1  $SPARK_JARS/postgresql-42.7.4.jar" | sha1sum -c -

COPY --chown=airflow:airflow . /opt/airflow/elt
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    SPARK_HOME=/home/airflow/.local/lib/python3.11/site-packages/pyspark \
    PYTHONPATH="/opt/elt:/opt/airflow/elt:${PYTHONPATH}"
