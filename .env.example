# ============================================================
# Configuracao ELT - Projeto Generico
# ============================================================

# ===== POSTGRES - CONEXOES PADRAO POR CAMADA =====
# Usadas quando o step nao especifica conexao_origem_id / conexao_destino_id

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=

BRONZE_DB=bronze
SILVER_DB=silver
GOLD_DB=gold

BRONZE_SCHEMA=global
SILVER_SCHEMA=global
GOLD_SCHEMA=global

# ===== TABELA DE PARAMETRIZACAO (SCHEDULE) =====
SCHEDULE_DB=gold
SCHEDULE_SCHEMA=global
SCHEDULE_TABLE=schedule

# ===== GOOGLE SHEETS (opcional) =====
# Usado pelo GoogleSheetsExtractor
# GOOGLE_SHEET_URL=
# Conn_id do Airflow com o service account (JSON) no campo extra/keyfile_json
# Usado quando a schedule nao informa conexao_origem_id
# GOOGLE_SHEETS_CONN_ID=google_sheets

# ===== MINIO (opcional) =====
# MINIO_ENDPOINT=minio.example.com:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=elt-bronze
# MINIO_SECURE=false

# ===== EMAIL (para alertas Airflow) =====
# EMAILS_ALERTA=["email@exemplo.com"]

# ===== AIRFLOW (conexoes usadas em producao) =====
# No Airflow, usar Connections em vez de .env:
# - Postgres Bronze:  conn_id "elt_bronze"  (tipo Postgres)
# - Postgres Silver:  conn_id "elt_silver"  (tipo Postgres)
# - Postgres Gold:    conn_id "elt_gold"    (tipo Postgres)
# - Google Sheets:    conn_id "google_sheets" (tipo Google Cloud / Generic)
# - FTP:              conn_id "ftp_datasus"  (tipo FTP)
# - MinIO:            conn_id "minio"        (tipo S3)
