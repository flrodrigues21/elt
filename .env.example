# ============================================================
# ELT Lab - Configuracao
# Copie este arquivo para .env e ajuste conforme necessario.
# O setup.ps1 gera automaticamente um .env com valores seguros.
# ============================================================

# ===== POSTGRES =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elt
POSTGRES_PASSWORD=

# ===== BANCOS POR CAMADA =====
BRONZE_DB=bronze
SILVER_DB=silver
GOLD_DB=gold

# ===== SCHEMAS PADRAO =====
BRONZE_SCHEMA=global
SILVER_SCHEMA=global
GOLD_SCHEMA=global

# ===== TABELA DE PARAMETRIZACAO =====
SCHEDULE_DB=elt
SCHEDULE_SCHEMA=global
SCHEDULE_TABLE=schedule

# ===== AIRFLOW =====
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=

# ===== MINIO =====
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=elt-datalake

# ===== GOOGLE SHEETS (opcional) =====
# GOOGLE_SHEET_URL=
# GOOGLE_SHEETS_CONN_ID=google_sheets

# ===== EMAIL (para alertas Airflow) =====
# EMAILS_ALERTA=["email@exemplo.com"]

# ===== JUPYTER =====
JUPYTER_PORT=8888
JUPYTER_USERNAME=
JUPYTER_PASSWORD=
